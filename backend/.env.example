# Secreto compartido entre servicios para firmar/verificar JWT (HS256).
# En produccion usar una clave de al menos 32 caracteres y rotarla.
JWT_SECRET=dev-secret-change-me-please-make-this-long-and-random

# URLs internas de los microservicios (cada uno en su propio puerto).
AUTH_SERVICE_URL=http://127.0.0.1:8001
USER_SERVICE_URL=http://127.0.0.1:8002
TOURNAMENT_SERVICE_URL=http://127.0.0.1:8003
PREDICTION_SERVICE_URL=http://127.0.0.1:8004
SCORING_SERVICE_URL=http://127.0.0.1:8005
RANKING_SERVICE_URL=http://127.0.0.1:8006
LEAGUE_SERVICE_URL=http://127.0.0.1:8007
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8008
